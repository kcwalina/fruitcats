  "about": "Berry Picnic is the holiday release. Its deck, Picnic Club, is a picnic in the grass with friends, snacks and the ants that always show up. Three cards sold on their own are wintry and festive.",
  "audience": "Young adults, mostly young women.",
  "style": "Basil's own style. The deck's characters are cute, silly and a little chaotic. The paid cards are showcase art.",
  "families": {
    "Berry": {
      "world": "a picnic in the grass: a blanket, a basket, berries, friends, sunshine",
      "note": "the deck's family; every Berry card should feel like the same picnic"
    },
    "Garden": {
      "world": "cosy and wintry for Ginger: a warm kitchen, a snowy window"
    },
    "Citrus": {
      "world": "wintry for Clementine: a frozen pond, snow, fairy lights"
    }
  },
  "milestones": [
    {
      "id": 1,
      "title": "Ginger (Foil single)",
      "note": "One picture, from sketch to finished. We get to know each other's taste on one card."
    },
    {
      "id": 2,
      "title": "Clementine (Gold single)",
      "note": "One picture, from sketch to finished."
    },
    {
      "id": 3,
      "title": "Noelle (Signature card)",
      "note": "Two pictures, Kitten and Big Cat: the best art in the set."
    },
    {
      "id": 4,
      "title": "Jam (the deck's main pictures)",
      "note": "Two pictures, Kitten and Big Cat. Signed in a corner."
    },
    {
      "id": 5,
      "title": "The rest of the deck, in batches",
      "note": "A few pictures at a time; we reply to each batch."
    },
    {
      "id": 6,
      "title": "Pawtraits",
      "note": "After each character's card picture is agreed, so the two match."
    },
    {
      "id": 7,
      "title": "Announcement key art",
      "note": "One wide picture for the release announcement."
    }
  ],
