#type FamilySet

id = 'jiaoren'
name = 'Jiaoren'
code = 'JR1'

family = Family {
  name = 'Jiaoren'
  main = '#D9735F'
  dark = '#7A2E2A'
  tint = '#FCE9E3'
}

keywords = [
  pearl-tears = Keyword { name = 'Pearl Tears' }
]

cards = [
  zhu-er = Hero {
    name = 'Zhu''er', epithet = 'the Littlest Jiaoren'
    number = 'JR1-H01', rarity = legendary
    frame = gold
    art = 'art/JR1-H01-kitten.webp'
    text = @zhu-er-text
    constants = [
      heal = 2
      fallen = 15
    ]
    flavor = 'Her name means Little Pearl. She has never cried a tear that wasn''t one.'
    back = Awakened {
      name = 'Zhu''er', epithet = 'Pearl of the Moonlit Sea', power = 3
      art = 'art/JR1-H01-bigcat.webp'
      text = @zhu-er-back-text
      constants = [extra-health = 1]
    }
  }
  the-spring-guest = Creature {
    name = 'The Spring Guest'
    cost = 2, power = 2, health = 4
    number = 'JR1-D01', rarity = uncommon
    art = 'art/JR1-D01.webp'
    text = 'Goodbye: Your units heal 2.'
    flavor = @the-spring-guest-flavor
  }
  weaver-of-the-sea-hall = Creature {
    name = 'Weaver of the Sea Hall'
    cost = 2, power = 2, health = 4
    number = 'JR1-D02', rarity = common
    art = 'art/JR1-D02.webp'
    text = 'Clash start: The units next to Weaver of the Sea Hall get +2 Health this round.'
    flavor = 'Deep under the South Sea, her loom never stops.'
  }
  dragon-silk = Talisman {
    name = 'Dragon Silk'
    cost = 3
    number = 'JR1-D03', rarity = uncommon
    art = 'art/JR1-D03.webp'
    text = 'Attached unit gets +3 Health and Guardian.'
    flavor = 'Woven by the jiaoren. A robe of it goes into the sea and comes out dry.'
  }
  pearl-oyster = Creature {
    name = 'Pearl Oyster'
    cost = 1, power = 1, health = 3
    number = 'JR1-D04', rarity = common
    art = 'art/JR1-D04.webp'
    keywords = [@Lure]
    text = 'Lure. Goodbye: Gain an Offering.'
    flavor = 'When the moon is full, the oysters are full. When the moon is dark, they are empty.'
  }
  jiaoren-of-the-tide-pools = Creature {
    name = 'Jiaoren of the Tide Pools'
    cost = 1, power = 1, health = 4
    number = 'JR1-D05', rarity = common
    art = 'art/JR1-D05.webp'
    text = 'Each bout: Jiaoren of the Tide Pools heals 1.'
    flavor = 'Lives in the water like a fish, and cries like one of us.'
  }
  ice-silkworm = Creature {
    name = 'Ice Silkworm'
    cost = 1, power = 3, health = 3
    number = 'JR1-D06', rarity = common
    art = 'art/JR1-D06.webp'
    text = ''
    flavor = @ice-silkworm-flavor
  }
  jiaoren-children-at-play = Creature {
    name = 'Jiaoren Children at Play'
    cost = 1, power = 3, health = 2
    number = 'JR1-D07', rarity = common
    art = 'art/JR1-D07.webp'
    keywords = [@Sneaky]
    text = 'Sneaky.'
    flavor = 'Racing the fish through the Dragon-Silk Palace.'
  }
  guest-from-the-deep = Creature {
    name = 'Guest from the Deep'
    cost = 2, power = 2, health = 5
    number = 'JR1-D08', rarity = common
    art = 'art/JR1-D08.webp'
    keywords = [@Guardian]
    text = 'Guardian.'
    flavor = 'The guests from the deep are moved to tears, and weep pearls.'
  }
  keeper-of-the-dragon-silk-palace = Creature {
    name = 'Keeper of the Dragon-Silk Palace'
    cost = 3, power = 2, health = 7
    number = 'JR1-D09', rarity = common
    art = 'art/JR1-D09.webp'
    keywords = [@Guardian]
    text = 'Guardian. Each bout: The units next to Keeper of the Dragon-Silk Palace heal 1.'
    flavor = 'Some of the silk inside is as white as frost. She lets no one near it.'
  }
  jiaoren-pearl-healer = Creature {
    name = 'Jiaoren Pearl-Healer'
    cost = 3, power = 3, health = 5
    number = 'JR1-D10', rarity = uncommon
    art = 'art/JR1-D10.webp'
    text = 'Every second bout: Your units heal 2.'
    flavor = 'A little pearl, ground to powder, for every hurt.'
  }
  muke = Creature {
    name = 'Muke', epithet = 'the Wood Guests'
    cost = 4, power = 6, health = 5
    number = 'JR1-D11', rarity = uncommon
    art = 'art/JR1-D11.webp'
    keywords = [@Elusive]
    text = 'Elusive. After Muke defeats a unit in combat, it heals 3.'
    flavor = 'They leave timber under the tree and take a fair price. Nobody ever sees their faces.'
  }
  elder-of-the-south-sea = Creature {
    name = 'Elder of the South Sea'
    cost = 5, power = 6, health = 9
    number = 'JR1-D12', rarity = uncommon
    art = 'art/JR1-D12.webp'
    keywords = [@Guardian, @Fierce]
    text = 'Guardian. Fierce. Each bout: Elder of the South Sea heals 2.'
    flavor = 'The jiaoren live beyond the South Sea. He has seen every wave of it.'
  }
  a-plate-of-pearls = Charm {
    name = 'A Plate of Pearls'
    cost = 1
    number = 'JR1-D13', rarity = uncommon
    art = 'art/JR1-D13.webp'
    keywords = [@Ambush]
    text = 'Ambush. A unit you control gets +2 Power this round. Gain an Offering.'
    flavor = 'The thank-you gift of a guest from the sea.'
  }
  the-sea-turns-rough = Charm {
    name = 'The Sea Turns Rough'
    cost = 3
    number = 'JR1-D14', rarity = uncommon
    art = 'art/JR1-D14.webp'
    text = 'Deal 4 damage to an enemy unit.'
    flavor = 'The South Sea is calm, until it isn''t.'
  }
  moonlit-sea = Charm {
    name = 'Moonlit Sea', epithet = 'Pearls with Tears'
    cost = 2
    number = 'JR1-D15', rarity = uncommon
    art = 'art/JR1-D15.webp'
    text = 'Exhaust an enemy unit.'
    flavor = 'A line from the poet Li Shangyin. Even enemies stop to look.'
  }
  frost-white-silk = Talisman {
    name = 'Frost-White Silk'
    cost = 2
    number = 'JR1-D16', rarity = uncommon
    art = 'art/JR1-D16.webp'
    text = 'Attached unit gets +2 Health and Pearl Tears.'
    flavor = 'The finest jiaoren silk, white as frost.'
  }
  quanxian = Fabled {
    name = 'Quanxian', epithet = 'First of the Springs'
    cost = 4, power = 4, health = 8
    number = 'JR1-D17', rarity = rare
    art = 'art/JR1-D17.webp'
    keywords = [@Guardian]
    text = 'Guardian. Each bout: Your units heal 1.'
    flavor = 'The jiaoren are also called the spring guests. She came first.'
  }
  the-muke-poet = Fabled {
    name = 'The Muke Poet'
    cost = 3, power = 4, health = 4
    number = 'JR1-D18', rarity = rare
    art = 'art/JR1-D18.webp'
    text = 'Goodbye: Your units get +2 Power this round.'
    flavor = '"The town is all noise and dust. Back to the mountain, to play with the moon."'
  }
  the-oldest-weaver = Fabled {
    name = 'The Oldest Weaver'
    cost = 5, power = 8, health = 7
    number = 'JR1-D19', rarity = rare
    art = 'art/JR1-D19.webp'
    keywords = [@Elusive, @Fierce]
    text = 'Elusive. Fierce. Clash start: Your units get +1 Power this round.'
    flavor = 'The jiaoren never stop weaving. She hasn''t stopped for a thousand years.'
  }
  tears-of-gratitude = Charm {
    name = 'Tears of Gratitude'
    cost = 1
    number = 'JR1-D20', rarity = uncommon
    art = 'art/JR1-D20.webp'
    keywords = [@Ambush]
    text = 'Ambush. A unit you control gets +3 Health this round.'
    flavor = 'Moved by a kindness, a jiaoren weeps pearls.'
  }
]

@@@ zhu-er-text
Exhaust: A unit you control gets +{heal} Health this round.
Awaken: {fallen} or more units have gone down in Clashes this game.
@@@ zhu-er-back-text
Your units get +{extra-health} Health and Pearl Tears.
Exhaust: Gain two Offerings.
@@@ the-spring-guest-flavor
She stayed a few days to sell her silk. Leaving, she wept a plate of pearls for her host.
@@@ ice-silkworm-flavor
Covered in frost and snow, it spins a cocoon a foot long. Its silk won't wet or burn.
@@@
