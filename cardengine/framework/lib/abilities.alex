// abilities: a player-activated ability on any card, with an optional cost, usable as an
// action (tap abilities, ignition effects, reap and fight, hero powers). Depends on common for
// Cost.
abilities = Library

name = 'Activated abilities'
version = '0.1'
core = '1'
requires = [@common]

extension Card {
  activate-cost: Cost?            // data: what activating costs, if anything
  activate-once-per-turn: bool = false
}
extension Card { activate: effect? }

actions = [
  ability = ActionKind { name = 'Use an ability' }
]

// Ability kinds this library declares; a card constructs one to say it has the ability.
type Activate : Ability { holders = [nameof(Card)] }
