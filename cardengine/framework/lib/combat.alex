// combat: units attacking units, heroes or life, and everything that decides who may attack
// what and what damage results. Depends on units.
#type Library

name = 'Combat'
version = '0.1'
requires = [@units]

type CombatRule : Rule {}
extension Game { combat: [CombatRule] = empty }

enum CombatTarget { unit, hero, life, permanent }

// Who chooses.
type AttackerChooses : CombatRule { targets: [CombatTarget] }
type DefenderBlocks : CombatRule { targets: [CombatTarget], max-per-attacker: int? }
type Lanes : CombatRule { count: int }
type Retreat : CombatRule { pay: Cost, once-per-turn: bool }
type TeamAttack : CombatRule {}                   // several units attack as one, powers summed
type TeamBlock : CombatRule {}                    // several units block one attacker
type BlockWithHandCard : CombatRule {}            // defend by playing a card from hand as a blocker
type BlockersNeedKeyword : CombatRule { keyword: Keyword }   // only units with it may block
type ZoneMatchedBlock : CombatRule {}             // a block works only from the matching zone
type MutualStrikeExchange : CombatRule { strikes: int }     // alternate strikes into a pool
type ReversalNegates : CombatRule {}              // a played reversal cancels the attack's damage
type ComboWindow : CombatRule { resource: text }  // pay mid-attack to add power from hand
type PokerHandContest : CombatRule { draw: int }  // draw n, rank as a poker hand, higher wins
type RowRestrictedTargeting : CombatRule {}       // front row shields the back row

// Who may attack, and whom.
type AttackerMustBeReady : CombatRule {}
type AttackTargetsPermanents : CombatRule {}     // permanents (a base, a tamer) may be attacked
// Units with the keyword must be attacked first. Without `keyword`: keywords of type Guardian.
type GuardiansFirst : CombatRule { keyword: Keyword? }
// Units with the keyword ignore Guardians. Without `keyword`: keywords of type Sneaky.
type SneakyIgnoresGuardians : CombatRule { keyword: Keyword? }
type CancelledAttackerStaysExhausted : CombatRule {}
type NoRetarget : CombatRule {}

// How damage works.
type SimultaneousDamage : CombatRule {}
type AttackerOnlyDamage : CombatRule {}
type TwoCombatDamageSteps : CombatRule {}         // first strike, then the rest
type DamagePersists : CombatRule {}
type DamageClearsAt : CombatRule { moment: Moment }
type LifeDamage : CombatRule { n: int }           // a hit on a hero or life costs n
type LifeDamageEqualsPower : CombatRule {}
type CombatDamageEqualsPower : CombatRule {}
type CompareStatDeletes : CombatRule {}           // higher power deletes lower, no damage pool
type TieDeletesBoth : CombatRule {}
type BattleDamageByStatDifference : CombatRule {}
type WeaknessResistance : CombatRule {}           // per-card type multipliers before damage

// Keywords with built-in meaning, two ways. A game that names this library's keyword type gets
// its meaning (`Swift = Swift {}`). A game that declares plain keywords (`Swift = Keyword {}`, as
// a printable game does) gives one its meaning with the rule that takes it
// (`GuardiansFirst { keyword = @Guardian }`), the keyword counterpart of `UnitCards { types }`.
type Guardian : Keyword {}                        // must be attacked first (Taunt, Bodyguard)
type Sneaky : Keyword {}                          // ignores Guardians (Evasive)
type Fierce : Keyword { value: int }              // a hit costs `value` life instead of 1
type FirstStrike : Keyword {}
type DoubleStrike : Keyword {}
type Trample : Keyword {}                         // excess damage past lethal goes through
type Windfury : Keyword {}                        // may attack twice
type Poisonous : Keyword {}                       // any damage it deals destroys
type Lifesteal : Keyword {}                       // damage it deals heals its controller
type Stealth : Keyword {}                         // cannot be targeted until it acts
type DivineShield : Keyword {}                    // negates the next hit, then is gone
type Elusive : Keyword {}                         // cannot be attacked unless the only target
type BlockableOnlyBy : Keyword { quality: text }  // flying and reach as one rule
type Ward : Keyword {}                            // cannot be chosen by an opponent's effect
type Blocker : Keyword {}                         // may block for another unit (intercept)
type Stun : Keyword {}                            // stunned: cannot ready next round either
// The rules that give a game's own keyword the meaning of the type named in the comment.
type HitCostsLife : CombatRule { keyword: Keyword, n: int }          // Fierce
type StrikesFirst : CombatRule { keyword: Keyword }                  // FirstStrike
type StrikesTwice : CombatRule { keyword: Keyword }                  // DoubleStrike
type ExcessDamageGoesThrough : CombatRule { keyword: Keyword }       // Trample
type AttacksTwice : CombatRule { keyword: Keyword }                  // Windfury
type AnyDamageDestroys : CombatRule { keyword: Keyword }             // Poisonous
type DamageHealsController : CombatRule { keyword: Keyword }         // Lifesteal
type UntargetableUntilItActs : CombatRule { keyword: Keyword }       // Stealth
type NegatesNextHit : CombatRule { keyword: Keyword }                // DivineShield
type AttackedOnlyWhenAlone : CombatRule { keyword: Keyword }         // Elusive
// BlockableOnlyBy: flying is `BlockedOnlyBy { keyword = @Flying, by = [@Flying, @Reach] }`.
type BlockedOnlyBy : CombatRule { keyword: Keyword, by: [Keyword] }
type OpponentsCantChoose : CombatRule { keyword: Keyword }           // Ward
type MayBlockForOthers : CombatRule { keyword: Keyword }             // Blocker
type StunSkipsReady : CombatRule { keyword: Keyword }                // Stun

// The attack this answers does nothing (`@a-whistle-in-the-dark.on-play = CancelAttack()`).
type CancelAttack : Effect {}

actions = [
  attack = ActionKind { name = 'Attack' }
]

events = [
  attack = Event { fields = [attacker = unit, target = target], cancellable = true }
  team-attack = Event { fields = [attackers = units, target = target], cancellable = true }
  combat = Event { fields = [attacker = unit, defender = unit] }
  hero-hit = Event {
    fields = [attacker = unit, defender = player, amount = int], cancellable = true
  }
]

extension UnitCard {
  on-attack: Effects?
  on-attacked: Effects?
  on-defeats-in-combat: Effects?
  on-you-heal: Effects?
}
extension Keyword {               // a keyword has a unit's slots (units)
  on-attack: Effects?
  on-attacked: Effects?
  on-defeats-in-combat: Effects?
  on-you-heal: Effects?
}

// Ability kinds this library declares; a card constructs one to say it has the ability.
type OnAttack : Ability { holders = [nameof(UnitCard)], event = nameof(events.attack) }
type OnAttacked : Ability { holders = [nameof(UnitCard)], event = nameof(events.attack) }
type OnDefeatsInCombat : Ability { holders = [nameof(UnitCard)], event = nameof(events.combat) }
type OnYouHeal : Ability { holders = [nameof(UnitCard)] }

filters = [
  guardian = Filter {}
  blocker = Filter {}
  in-row = Filter { params = [row = text] }
]

selectors = [
  adjacent = Selector { yields = units, params = [to = unit] }   // neighbours in a row zone
]
