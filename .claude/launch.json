{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "apps/web",
        "--host"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "studio-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "studio:dev",
        "-w",
        "@fruitcats/api"
      ],
      "port": 8787
    }
  ]
}
