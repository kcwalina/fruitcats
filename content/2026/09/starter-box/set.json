  "mechanics": {
    "Zest": {
      "family": "Citrus",
      "kind": "condition",
      "reminder": "A bonus if this is not the first card you have played this round.",
      "if": {
        "playedThisRound": {
          "atLeast": 2
        }
      },
      "label": true
    },
    "Ripen": {
      "family": "Orchard",
      "kind": "keyword",
      "reminder": "At the start of each round this unit gets +1 Power and +1 Health, up to +2/+2.",
      "counter": {
        "name": "ripe",
        "power": 1,
        "health": 1,
        "log": "{name} ripens (+{n}/+{n})."
      },
      "abilities": [
        {
          "when": "roundStart",
          "inline": true,
          "target": "self",
          "do": [
            {
              "counter": {
                "name": "ripe",
                "add": 1,
                "max": 2
              }
            }
          ]
        }
      ],
      "icon": "🍎"
    },
    "Lush": {
      "family": "Tropical",
      "kind": "condition",
      "reminder": "This bonus is on while you have 7 or more Treats.",
      "if": {
        "treats": {
          "atLeast": 7
        }
      },
      "badge": {
        "icon": "🌴",
        "title": "Lush: 7 or more Treats — Lush bonuses are on"
      }
    },
    "Sprout": {
      "family": "Tropical",
      "kind": "action",
      "reminder": "Put that many cards from the top of your deck into your Treats."
    }
  },
