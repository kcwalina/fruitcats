<Project Sdk="Microsoft.NET.Sdk">

  <!-- tcg: the TCG developer platform's command-line tool. It reads a game's Alex files with the C# Alex, taken as
       NuGet packages from packages/ (nuget.config), so tcg builds from this repository alone. To move to a newer
       Alex, pack it from the mochi repository into packages/ and change the version here:
         dotnet pack <mochi>/mochi.agents/alex/src/Alex/ViaMochi.Alex.csproj -c Release -o packages
         dotnet pack <mochi>/mochi.agents/alex/src/Alex.Model/ViaMochi.Alex.Model.csproj -c Release -o packages -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tcg</AssemblyName>
    <RootNamespace>Tcg</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ViaMochi.Alex" Version="0.6.0" />
    <PackageReference Include="ViaMochi.Alex.Model" Version="0.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core schema the game files are written against (schema-version 1). -->
    <EmbeddedResource Include="../framework/core.alex" LogicalName="core.alex" />
  </ItemGroup>

</Project>
