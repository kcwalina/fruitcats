#type CardLayout

width = 750
height = 1050
dpi = 300
text-spacing = whole-pixels

fonts = [
  black = 'seguibl.ttf'
  bold = 'segoeuib.ttf'
  bold-italic = 'segoeuiz.ttf'
  regular = 'segoeui.ttf'
  italic = 'segoeuii.ttf'
]

finishes = [
  foil = Finish { texture = 'art/finishes/foil.png', ink = '#4A5362' }
  gold = Finish { texture = 'art/finishes/gold.png', ink = '#5A3A04' }
  prismatic = Finish { texture = 'art/finishes/prismatic.png', ink = '#3A2A5A' }
  signature = Finish { texture = 'art/finishes/rainbow-signature.png', ink = '#0B0810' }
]

file-names = [
  Hero = '{number}-kitten'
  Awakened = '{number}-bigcat'
]

frames = [
  Card = Frame {
    ink = '{family.dark}'
    accent = '{family.main}'
    tint = '{family.tint}'
  }
  citrus = Frame {
    ink = '#A86400'
    accent = '#F29F05'
    tint = '#FFF1CC'
  }
  orchard = Frame {
    ink = '#8E2A2A'
    accent = '#D64545'
    tint = '#FBE0DA'
  }
  tropical = Frame {
    ink = '#A24E05'
    accent = '#F2780C'
    tint = '#FFE6CC'
  }
  garden = Frame {
    ink = '#3B7430'
    accent = '#5FA84D'
    tint = '#E3F2DC'
  }
  berry = Frame {
    ink = '#8F1D46'
    accent = '#D6336C'
    tint = '#FBDDE7'
  }
  melon = Frame {
    ink = '#25714A'
    accent = '#3FA66B'
    tint = '#DDF3E6'
  }
  pepper = Frame {
    ink = '#5A0E0A'
    accent = '#D7261E'
    tint = '#FFD6C2'
  }
  violet = Frame {
    ink = '#1E1236'
    accent = '#4A2F7A'
    tint = '#EFE8FF'
  }
  sky = Frame {
    ink = '#1D4A78'
    accent = '#3B82C4'
    tint = '#E1EEFB'
  }
  midnight = Frame {
    ink = '#141C2B'
    accent = '#2B3A55'
    tint = '#E6ECF7'
  }
  gold = Frame {
    ink = '#7A5A0C'
    accent = '#C8961E'
    tint = '#FFF3CF'
  }
  ink = Frame {
    ink = '#161616'
    accent = '#3A3A3A'
    tint = '#EEEEEE'
  }
  image = Frame {
    ink = '#161616'
    accent = '#3A3A3A'
    tint = '#EEEEEE'
    texture = '{frame-image}'
  }
]

parts = [
  border = Shape {
    box = Box { x = 0, y = 0, width = 750, height = 1050 }
    radius = 42
    fill = ink
    chrome = true
    frame-texture = true
  }
  panel = Shape {
    box = Box { x = 21, y = 21, width = 708, height = 1008 }
    radius = 30
    fill = '#FFF8EC'
  }
  art-pending = Shape {
    box = Box { x = 42, y = 138, width = 666, height = 444 }
    radius = 18
    fill = tint
    unless = '{art}'
  }
  art-pending-note = Label {
    show = 'art pending'
    box = Box { x = 42, y = 138, width = 666, height = 444 }
    font = @italic
    size = 34
    color = '#7A6A5C'
    align = center
    unless = '{art}'
  }
  art = Picture {
    show = '{art}'
    box = Box { x = 42, y = 138, width = 666, height = 444 }
    fit = cover
    corner-radius = 18
  }
  art-border = Shape {
    box = Box { x = 42, y = 138, width = 667, height = 445 }
    radius = 18
    outline = accent
    outline-width = 6
    chrome = true
    chrome-width = 7
    frame-texture = true
  }
  banner = Shape {
    box = Box { x = 36, y = 30, width = 679, height = 97 }
    radius = 26
    fill = accent
    outline = ink
    outline-width = 4
    chrome = true
    chrome-width = 5
    frame-texture = true
  }
  banner-edge = Shape {
    box = Box { x = 36, y = 30, width = 679, height = 97 }
    radius = 26
    outline = ink
    outline-width = 4
    only-with-frame-texture = true
    only-without-finish = true
  }
  panel-inner-edge = Shape {
    box = Box { x = 21, y = 21, width = 708, height = 1008 }
    radius = 30
    outline = ink
    outline-width = 2
    only-with-frame-texture = true
  }
  cost-circle = Shape {
    kind = circle
    box = Box { x = 30, y = 26, width = 103, height = 103 }
    fill = '#FFFFFF'
  }
  cost-ring = Shape {
    kind = circle
    box = Box { x = 30, y = 26, width = 103, height = 103 }
    outline = ink
    outline-width = 8
    chrome = true
    chrome-width = 9
  }
  star = Shape {
    kind = star
    box = Box { x = 43, y = 41, width = 76, height = 76 }
    fill = accent
    only-types = [@Hero, @Awakened]
  }
  type-strip = Shape {
    box = Box { x = 42, y = 596, width = 667, height = 53 }
    radius = 14
    fill = tint
    outline = accent
    outline-width = 3
    chrome = true
    chrome-width = 4
  }
  panel-edge = Shape {
    box = Box { x = 21, y = 21, width = 708, height = 1008 }
    radius = 30
    outline = finish-ink
    outline-width = 2
    only-with-finish = true
  }
  outer-edge = Shape {
    box = Box { x = 1, y = 1, width = 748, height = 1048 }
    radius = 41
    outline = finish-ink
    outline-width = 2
    only-with-finish = true
  }
  cost-edge = Shape {
    kind = circle
    box = Box { x = 30, y = 26, width = 103, height = 103 }
    outline = finish-ink
    outline-width = 2
    only-with-finish = true
  }
  cost-inner-edge = Shape {
    kind = circle
    box = Box { x = 38, y = 34, width = 87, height = 87 }
    outline = finish-ink
    outline-width = 2
    only-with-finish = true
  }
  art-edge = Shape {
    box = Box { x = 42, y = 138, width = 667, height = 445 }
    radius = 18
    outline = finish-ink
    outline-width = 1
    only-with-finish = true
  }
  art-inner-edge = Shape {
    box = Box { x = 49, y = 145, width = 653, height = 431 }
    radius = 12
    outline = finish-ink
    outline-width = 1
    only-with-finish = true
  }
  text-panel = Shape {
    box = Box { x = 42, y = 660, width = 667, height = 253 }
    radius = 18
    fill = '#FFFFFF'
    outline = '#E2D3BA'
    outline-width = 3
  }
  cost = Label {
    show = '{cost}'
    box = Box { x = 30, y = 26, width = 102, height = 100 }
    font = @black
    size = 60
    color = ink
    align = center
  }
  lucky = Picture {
    show = 'art/icons/lucky.png'
    box = Box { x = 632, y = 150, width = 64, height = 64 }
    if-keyword = @Lucky
  }
  name = Title {
    show = '{name}'
    subtitle = '{epithet}'
    box = Box { x = 150, y = 34, width = 520, height = 88 }
    font = @bold
    size = 42
    smallest = 26
    baseline = 34
    subtitle-font = @bold-italic
    subtitle-size = 25
    subtitle-baseline = 70
    subtitle-indent = 2
    color = '#FFFFFF'
    outline = ink
    outline-width = 2
  }
  type-line = Label {
    show = '{type} · {family.name}'
    box = Box { x = 62, y = 600, width = 460, height = 44 }
    font = @bold
    size = 25
    color = ink
    capitals = true
  }
  collector = Row {
    box = Box { x = 400, y = 610, width = 288, height = 24 }
    items = [
      Icon {
        show = '{finish}'
        images = [
          foil = 'art/icons/finish-foil.png'
          gold = 'art/icons/finish-gold.png'
          prismatic = 'art/icons/finish-prismatic.png'
          signature = 'art/icons/finish-rainbow-signature.png'
        ]
        width = 26
        height = 24
        gap = 8
      }
      Label { show = '{number}', font = @regular, size = 20, color = '#7A6A5C', gap = 4 }
      Icon {
        show = '{rarity}'
        images = [
          common = 'art/icons/common.png'
          uncommon = 'art/icons/uncommon.png'
          rare = 'art/icons/rare.png'
          legendary = 'art/icons/legendary.png'
        ]
        width = 32
        height = 32
      }
    ]
  }
  rules = TextBox {
    box = Box { x = 42, y = 660, width = 666, height = 252 }
    padding = 24
    padding-top = 18
    size = 31
    smallest = 18
    line-height = 1.3
    paragraphs = [
      Paragraph {
        show = '{text}'
        font = @regular
        bold-font = @bold
        italic-font = @italic
        emphasis = [
          Bold { words = keywords, with-number = true }
          Bold { up-to = ':' }
          Italic { between = '()' }
        ]
        color = '#2B211B'
      }
      Paragraph {
        show = '{flavor}'
        font = @italic
        size-change = -5
        smallest = 16
        color = '#7A6A5C'
        align = center
        rule-above = '#E2D3BA'
        rule-inset = 150
        rule-offset = 7
        rule-width = 2
        rule-gap = 18
      }
    ]
  }
  power = Chip {
    show = '{power}'
    icon = 'art/icons/power.png'
    icon-color = ink
    box = Box { x = 42, y = 930, width = 666, height = 62 }
    align = left
    font = @black
    size = 40
    color = ink
    padding = 14
    icon-size = 34
    gap = 8
    fill = tint
    outline = accent
    outline-width = 2
    text-offset = 1
  }
  health = Chip {
    show = '{health}'
    icon = 'art/icons/heart.png'
    icon-color = '#D9486C'
    box = Box { x = 42, y = 930, width = 666, height = 62 }
    align = right
    font = @black
    size = 40
    color = ink
    padding = 14
    icon-size = 34
    gap = 8
    fill = tint
    outline = accent
    outline-width = 2
    text-offset = 1
  }
  footer = Label {
    show = 'Folkborn · {set.name} · © 2026'
    box = Box { x = 0, y = 989, width = 750, height = 22 }
    font = @regular
    size = 17
    color = '#7A6A5C'
    align = center
  }
]
