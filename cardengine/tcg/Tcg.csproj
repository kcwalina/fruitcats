<Project Sdk="Microsoft.NET.Sdk">

  <!-- tcg: the TCG developer platform's command-line tool. It reads a game's Alex files with the C# Alex
       from the mochi repository (AlexSrc; override with -p:AlexSrc=... or the TCG_ALEX_SRC variable). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tcg</AssemblyName>
    <RootNamespace>Tcg</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AlexSrc Condition="'$(AlexSrc)' == '' AND '$(TCG_ALEX_SRC)' != ''">$(TCG_ALEX_SRC)</AlexSrc>
    <AlexSrc Condition="'$(AlexSrc)' == ''">C:\git\mochi\.claude\worktrees\tcg-alex\mochi.agents\alex\src</AlexSrc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AlexSrc)\Alex\ViaMochi.Alex.csproj" />
    <ProjectReference Include="$(AlexSrc)\Alex.Model\ViaMochi.Alex.Model.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core schema the game files are written against (schema-version 1). -->
    <EmbeddedResource Include="../framework/core.alex" LogicalName="core.alex" />
  </ItemGroup>

</Project>
