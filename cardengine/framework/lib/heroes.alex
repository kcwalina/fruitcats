// heroes: a card that is always in play and represents the player (Hero, leader, avatar,
// planeswalker), with one or two faces, optional stats of its own, and a repeatable ability.
// Depends on the core only.
#type Library

name = 'Heroes'
version = '0.1'
requires = [@common]

// A hero prints its faces as records (`face1`, `face2`), or a game maps its own hero type, whose
// card is the first face and whose second face is a card of another type (`HeroCards`).
type HeroCard : Card {
  face1: Face?
  face2: Face?
  life: int?                      // when the hero card fixes the player's life total
  hand-size: int?                 // when the hero card fixes the hand size (intellect)
}
type Face {
  name: text
  power: int?
  health: int?
  keywords: [Keyword | Applied] = empty
  abilities: [Ability] = empty
}
// Equipment for the hero itself, with power and a durability that depletes (Hearthstone).
type WeaponCard : Card { cost: Cost, power: int, durability: int }

type HeroRule : Rule {}
extension Game { hero: [HeroRule] = empty }

// The other side of a mapped hero: a card of the game's own type, held by a field of the hero.
type HeroFaceCard : Card {}

// Which of the game's card types are heroes and weapons; see core.alex on mapping. `second-face`
// is the type of the hero's other side (`second-face = @Awakened`, held by `back: Awakened`).
type HeroCards : HeroRule { types: [type HeroCard], second-face: type HeroFaceCard? }
type WeaponCards : HeroRule { types: [type WeaponCard] }

type TwoFaces : HeroRule {}                           // face 2 is reached by awakening
type AwakenOnStateCheck : HeroRule {}                 // flip as soon as the condition holds
type AwakenedKeepsExhaustedState : HeroRule {}
type AwakenedNeverReverts : HeroRule {}
type HeroAttacksWhenAwakened : HeroRule { takes-no-damage: bool }
type PowerOncePerRound : HeroRule {}                  // the face's `exhaust` ability, once a round
type PowerOncePerGame : HeroRule {}
type Levels : HeroRule { counter: text, faces: int }   // faces reached by a counter (XP, grow)
type PayToFlip : HeroRule { cost: Cost }               // the second face is paid for, not earned
type HeroIsUnit : HeroRule {}                          // the hero fights and takes damage like one
type HeroRespawns : HeroRule { after: int }            // a defeated hero returns after n turns

extension Face {
  exhaust: effect?
  awaken: condition?
}
extension HeroCard {
  exhaust: effect?
  awaken: condition?
  static: static?
}
extension HeroFaceCard {
  exhaust: effect?
  awaken: condition?
  static: static?
}

verbs = [
  awakened = Verb { on = unit, yields = bool, only-in = scenario }   // then awakened(@dziadzius)
]

// Ability kinds this library declares; a card constructs one to say it has the ability.
type Exhaust : Ability { holders = [nameof(Face)] }
type Awaken : Ability { holders = [nameof(Face)], kind = condition }
