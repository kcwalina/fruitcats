// decks: deck construction rules. Depends on common for Rarity.
#type Library

name = 'Deck construction'
version = '0.1'
requires = [@common]

type DeckRule : Rule {}
extension Game { deck-rules: [DeckRule] = empty }

type DeckSize : DeckRule { n: int }
type DeckSizeRange : DeckRule { min: int, max: int }
type CopiesMax : DeckRule { n: int }
type CopyLimit : DeckRule { type: CardType | text, copies: int, total: int? }
type CopyLimitByRarity : DeckRule { rarity: Rarity, copies: int }
type TypeCount : DeckRule { type: CardType | text, min: int, max: int }   // exactly one Hero: 1, 1
// A second pool with its own size (extra deck, egg deck, sideboard).
type DeckPool : DeckRule { name: text, zone: Zone, min: int, max: int }
type ZoneMinimum : DeckRule { zone: Zone, n: int }
type GroupCount : DeckRule { of: text, n: int }          // exactly n groups (houses)
type CardsPerGroup : DeckRule { of: text, n: int }
type FactionLock : DeckRule { of: text }                 // one faction per deck
type ComposedCards : DeckRule {}                         // a card is a base plus a chosen overlay

extension Card { copies-max: int? }               // a card's own copy limit overrides CopiesMax
extension Deck { hero: Card?, price: int? }
