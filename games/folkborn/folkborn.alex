#type Game

name = 'Folkborn'
schema-version = 1
card-layout = @card-layout
sets = [
  @domowiki
  @pari
  @aluxes
  @jiaoren
  @hui-hai
  @mochi
  @flower-souls
]

keywords = [
  Swift = Keyword {}
  Guardian = Keyword {}
  Sneaky = Keyword {}
  Fierce = Keyword {}
  Tough = Keyword {}
  Lucky = Keyword {}
  Ambush = Keyword {}
]

enum Rarity { common, uncommon, rare, legendary }
enum Finish { standard, foil, gold, prismatic, signature }
enum Palette { citrus, orchard, tropical, garden, berry, melon, pepper, violet, sky, midnight, gold, ink, image }

type Family {
  name: text
  main: text
  dark: text
  tint: text
}

type Printed : Card {
  number: text
  rarity: Rarity?
  epithet: text?
  family: Family?
  frame: Palette?
  frame-image: text?
  finishes: [Finish] = [standard, foil, gold, prismatic]
}
type Creature : Printed {
  cost: int
  power: int
  health: int
}
type Fabled : Printed {
  cost: int
  power: int
  health: int
}
type Charm : Printed {
  cost: int
}
type Talisman : Printed {
  cost: int
}
type Hero : Printed {
  back: Awakened
}
type Awakened : Card {
  type-name = 'Hero · Awakened'
  epithet: text?
  power: int?
}
type TokenCreature : Creature {
  type-name = 'Token Creature'
  finishes = [standard]
}
