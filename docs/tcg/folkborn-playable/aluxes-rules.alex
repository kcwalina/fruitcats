#type Rules

for = @aluxes

// §850.5 The rain counter's `max` stops it at +2/+2.
effect rain-falls { this.counter(@rain, 1) }

condition few-candles { own.life.count <= card.candles }
effect heal-and-guard {
  target = choose(own)
  target.heal(card.heal)
  target.buff(guardian, until: this-round)
}

effect heal-a-unit { choose(all).heal(card.heal) }
effect draw-if-guardian { if units(own, guardian).any { draw() } }
effect heal-own-and-draw {
  choose(own).heal(card.heal)
  draw()
}
effect damage-an-exhausted-unit { choose(all, exhausted).damage(card.damage) }

// §600.3 The attacker stays exhausted.
effect cancel-the-attack { event.cancel() }

effect draw-once-a-round { once-per-round { draw() } }

@rain-fed.on-round-start = rain-falls

@aluxito.exhaust = heal-own
@aluxito.awaken = few-candles
@aluxito.back.exhaust = heal-and-guard

@saka-bearing-alux.on-enter = heal-a-unit
@corn-tending-alux.on-enter = draw-if-guardian
@tool-hiding-alux.on-enter = exhaust-an-enemy
@a-whistle-in-the-dark.on-play = cancel-the-attack
@honey-and-tortillas.on-play = heal-own-and-draw
@pots-and-pans-flung.on-play = damage-an-exhausted-unit
@kahtal-alux.static = attached-health-and-guardian
@the-roadside-alux.on-you-heal = draw-once-a-round
@the-alux-of-the-sacred-cenote.on-round-start = heal-each-own
@toh.on-enter = draw-a-card
@a-sweet-on-the-doorstep.on-play = boost-own
@lost-in-the-monte.on-play = exhaust-an-enemy
