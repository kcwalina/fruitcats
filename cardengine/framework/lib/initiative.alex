// initiative: a token that says who acts first (the Lantern, the attack token, the first-player
// marker) and how it moves. Depends on the core only.
initiative = Library

name = 'Initiative'
version = '0.1'
core = '1'

type InitiativeRule : Rule {}
extension Game { initiative: [InitiativeRule] = empty }

type InitiativeToken : InitiativeRule { name: text }
type TakeInitiativeAsAction : InitiativeRule {}
type AutoPassAfterTaking : InitiativeRule {}
type TakeOncePerRound : InitiativeRule {}
type InitiativePassesIfUntaken : InitiativeRule {}
type InitiativeAlternates : InitiativeRule {}     // swaps every round without an action

actions = [
  take-initiative = ActionKind { name = 'Take the initiative' }
]
