#type Game

name = 'Hello TCG'
schema-version = 1
rulebook = @rulebook
card-layout = @card-layout
card-back = 'art/card-back.png'

constants = [
  starting-life = 10
  opening-hand = 3
  energy-growth = 1
  max-energy = 4
  deck-size = 12
  max-copies = 3
]

keywords = [
  Guardian = Keyword {}
  Swift = Keyword {}
]

type Creature : Card {
  cost: int
  power: int
  health: int
}
type Charm : Card {
  cost: int
}
