    "Heat": {
      "family": "Pepper",
      "kind": "keyword",
      "reminder": "Whenever this unit is dealt damage and survives, it gets +1 Power, up to +3.",
      "counter": {
        "name": "heat",
        "power": 1,
        "log": "{name} heats up (+{n} Power)."
      },
      "abilities": [
        {
          "when": "damagedAndSurvives",
          "target": "self",
          "do": [
            {
              "counter": {
                "name": "heat",
                "add": 1,
                "max": 3
              }
            }
          ]
        }
      ],
      "icon": "🔥"
    }
  },
