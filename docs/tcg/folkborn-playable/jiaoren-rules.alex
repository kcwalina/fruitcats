#type Rules

// §850.6
@pearl-tears.on-survives-damage = ready-resources(one)

@zhu-er.static = units(own).grant(pearl-tears)
@zhu-er.exhaust = choose(own).heal(card.heal)
// Both players' Mists count, as today's engine counts them.
@zhu-er.awaken = cards(@Mist, all, unit-card).count >= card.fallen
@zhu-er.back.static = units(own).grant(health: card.extra-health, pearl-tears)
@zhu-er.back.exhaust = ready-resources(two)

@the-spring-guest.on-defeated = ready-resources(two)
@weaver-of-the-sea-hall.on-enter = draw()
@dragon-silk.static = attached.grant(health: card.extra-health, guardian)
@pearl-oyster.on-enter = ready-resources(one)
@jiaoren-pearl-healer.on-enter = units(own).heal(card.heal)
@muke.on-enter = draw()
@a-plate-of-pearls.on-play = boost-own-and-ready-an-offering
@the-sea-turns-rough.on-play = choose(all).damage(card.damage)
@moonlit-sea.on-play = choose(opponents).exhaust()
@frost-white-silk.static = attached.grant(health: card.extra-health, pearl-tears)
@quanxian.on-enter = ready-resources(two)
@the-muke-poet.on-defeated = draw(card.draw)
@tears-of-gratitude.on-play = choose(own).buff(power: card.boost, until: this-round)
