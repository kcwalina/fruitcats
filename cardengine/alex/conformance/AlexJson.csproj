<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prints how the C# Alex reads .alex files, as JSON, for alex.test.ts to compare with the TypeScript reader. It
       builds the C# Alex from the mochi repository checked out beside this one, as cardengine/tcg does. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MochiRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'mochi\mochi.agents\alex\src\Alex\ViaMochi.Alex.csproj'))</MochiRoot>
    <AlexSrc>$(MochiRoot)\mochi\mochi.agents\alex\src</AlexSrc>
  </PropertyGroup>

  <Target Name="RequireAlex" BeforeTargets="ResolveProjectReferences" Condition="'$(MochiRoot)' == ''">
    <Error Text="The Alex conformance check needs the mochi repository checked out beside this one (for example C:\git\mochi next to C:\git\fruitcats)." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(AlexSrc)\Alex\ViaMochi.Alex.csproj" />
    <ProjectReference Include="$(AlexSrc)\Alex.Model\ViaMochi.Alex.Model.csproj" />
  </ItemGroup>

</Project>
