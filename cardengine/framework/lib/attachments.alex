// attachments: cards that sit on a unit and change it (Talismans, auras, equipment, tools,
// energy). Depends on units for Grant and on common for Cost.
#type Library

name = 'Attachments'
version = '0.1'
requires = [@common, @units]

type AttachmentCard : Card {
  cost: Cost
  per-unit: int = 1               // fixed by the game's type; how many may sit on one unit
  attached: Grant?                // what it grants, as data; printed text grants it with a static handler
}

// Rules about attachments, listed in the game's `attachments` area. `AttachmentCards` says which
// of the game's card types are attachments; see core.alex on mapping.
type AttachmentRule : Rule {}
extension Game { attachments: [AttachmentRule] = empty }
type AttachmentCards : AttachmentRule { types: [type AttachmentCard] }

extension AttachmentCard {
  on-attach: effect?
  on-detach: effect?
  static: static?
}

selectors = [
  attached = Selector { yields = unit }                 // the unit this attachment is on
  here = Selector { yields = units, params = [of = unit] }   // the objects attached to a unit
]

// Ability kinds this library declares; a card constructs one to say it has the ability.
type OnAttach : Ability { holders = [nameof(AttachmentCard)] }
type OnDetach : Ability { holders = [nameof(AttachmentCard)] }
type AttachedStatic : Ability { holders = [nameof(AttachmentCard)], kind = static }
