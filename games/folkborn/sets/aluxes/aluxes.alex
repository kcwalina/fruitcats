#type FamilySet

id = 'aluxes'
name = 'Aluxes'
code = 'AL1'

family = Family {
  name = 'Aluxes'
  main = '#2E8FA3'
  dark = '#1A4D5C'
  tint = '#DCF1F5'
}

keywords = [
  rain-fed = Keyword { name = 'Rain-Fed' }
]
counters = [
  rain = StatCounter { power = 1, health = 1, max = @rain-fed-max }
]

cards = [
  aluxito = Hero {
    name = 'Aluxito', epithet = 'Keeper of the Milpa'
    number = 'AL1-H01', rarity = legendary
    frame = gold
    art = 'art/AL1-H01-kitten.webp'
    text = @aluxito-text
    flavor = 'Knee-high and invisible. Every corn stalk in the field is his.'
    back = Awakened {
      name = 'Aluxito', epithet = 'Caller of the Rain', power = 3
      art = 'art/AL1-H01-bigcat.webp'
      text = 'Exhaust: A unit you control gets +2 Rain-Fed.'
    }
  }
  saka-bearing-alux = Creature {
    name = 'Saká-Bearing Alux'
    cost = 2, power = 1, health = 6
    number = 'AL1-D01', rarity = common
    art = 'art/AL1-D01.webp'
    text = 'Support. At the start of each round, the units next to Saká-Bearing Alux get +1 Rain-Fed.'
    flavor = 'A gourd of sweet corn drink, carried to whoever needs it most.'
  }
  night-patrol-alux = Creature {
    name = 'Night Patrol Alux'
    cost = 1, power = 2, health = 4
    number = 'AL1-D02', rarity = common
    art = 'art/AL1-D02.webp'
    keywords = [@Taunt]
    text = 'Tank. Taunt.'
    flavor = 'Walks the rows all night. Nothing gets to the corn.'
  }
  corn-tending-alux = Creature {
    name = 'Corn-Tending Alux'
    cost = 3, power = 3, health = 5
    number = 'AL1-D03', rarity = common
    art = 'art/AL1-D03.webp'
    text = 'Mage. Every second bout: Deal 3 damage to the enemy across.'
    flavor = 'Tends the field while the farmer sleeps. The corn is taller by morning.'
  }
  clay-alux = Creature {
    name = 'Clay Alux', epithet = 'Fresh from the J-meen'
    cost = 1, power = 3, health = 4
    number = 'AL1-D04', rarity = common
    art = 'art/AL1-D04.webp'
    text = 'Bruiser. At the start of each round, Clay Alux gets +1 Rain-Fed.'
    flavor = 'Shaped from clay by the healer. Seven weeks of prayers, and it stands up.'
  }
  tool-hiding-alux = Creature {
    name = 'Tool-Hiding Alux'
    cost = 2, power = 5, health = 3
    number = 'AL1-D05', rarity = common
    art = 'art/AL1-D05.webp'
    text = 'Assassin. Clash start: The enemy across gets -2 Power this round.'
    flavor = 'Your machete was right here. Now it isn''t.'
  }
  slingshot-alux = Creature {
    name = 'Slingshot Alux'
    cost = 2, power = 5, health = 3
    number = 'AL1-D06', rarity = uncommon
    art = 'art/AL1-D06.webp'
    text = 'Marksman.'
    flavor = 'Dressed like a farmer, with a slingshot in his sash. Coatis know him.'
  }
  alux-of-the-old-stones = Creature {
    name = 'Alux of the Old Stones'
    cost = 3, power = 3, health = 9
    number = 'AL1-D07', rarity = uncommon
    art = 'art/AL1-D07.webp'
    keywords = [Applied { keyword = @Tough, n = 1 }]
    text = 'Tank. Tough 1.'
    flavor = 'Lives in the fallen stones of a ruin. Stone doesn''t feel a hit.'
  }
  alux-of-the-ceiba-roots = Creature {
    name = 'Alux of the Ceiba Roots'
    cost = 4, power = 5, health = 11
    number = 'AL1-D08', rarity = uncommon
    art = 'art/AL1-D08.webp'
    keywords = [@Taunt]
    text = 'Tank. Taunt. At the start of each round, Alux of the Ceiba Roots gets +1 Rain-Fed.'
    flavor = 'The healer set his clay figure under the oldest tree. He grew into it.'
  }
  a-whistle-in-the-dark = Charm {
    name = 'A Whistle in the Dark'
    cost = 1
    number = 'AL1-D09', rarity = uncommon
    art = 'art/AL1-D09.webp'
    keywords = [@Ambush]
    text = 'Ambush. The enemy unit across from this Ambush deals no damage this Clash.'
    flavor = 'He walks the field at night and whistles. Thieves and animals turn back.'
  }
  honey-and-tortillas = Charm {
    name = 'Honey and Tortillas'
    cost = 2
    number = 'AL1-D10', rarity = uncommon
    art = 'art/AL1-D10.webp'
    text = 'A unit you control gets +1 Rain-Fed. It gets +2 Health this round.'
    flavor = 'Left on the little doorstep at dusk. Gone by morning.'
  }
  pots-and-pans-flung = Charm {
    name = 'Pots and Pans Flung'
    cost = 2
    number = 'AL1-D11', rarity = uncommon
    art = 'art/AL1-D11.webp'
    text = 'Deal 3 damage to an enemy unit.'
    flavor = 'Fall asleep without leaving an offering, and the kitchen lets you know.'
  }
  kahtal-alux = Talisman {
    name = 'Kahtal Alux', epithet = 'the Little House'
    cost = 2
    number = 'AL1-D12', rarity = uncommon
    art = 'art/AL1-D12.webp'
    text = 'Attached unit gets +3 Health and Taunt.'
    flavor = @kahtal-alux-flavor
  }
  the-roadside-alux = Creature {
    name = 'The Roadside Alux'
    cost = 4, power = 5, health = 8
    number = 'AL1-D13', rarity = rare
    art = 'art/AL1-D13.webp'
    text = 'Mage. Every second bout: Deal 2 damage to the enemy across and the ones next to it.'
    flavor = 'Stops travellers and asks for a little something. Give it, and luck follows you home.'
  }
  the-alux-of-the-sacred-cenote = Fabled {
    name = 'The Alux of the Sacred Cenote'
    cost = 5, power = 3, health = 14
    number = 'AL1-D14', rarity = rare
    art = 'art/AL1-D14.webp'
    text = 'Support. At the start of each round, each unit you control get +1 Rain-Fed.'
    flavor = 'Guards the deep pool where the rain begins.'
  }
  the-bridge-alux-of-cancun = Fabled {
    name = 'The Bridge Alux of Cancún'
    cost = 4, power = 4, health = 12
    number = 'AL1-D15', rarity = rare
    art = 'art/AL1-D15.webp'
    keywords = [@Taunt, Applied { keyword = @Tough, n = 1 }]
    text = 'Tank. Taunt. Tough 1.'
    flavor = 'The bridge fell three times. Then they built him a house, and it stood.'
  }
  the-aluxs-dog = Creature {
    name = 'The Alux''s Dog'
    cost = 1, power = 3, health = 4
    number = 'AL1-D16', rarity = common
    art = 'art/AL1-D16.webp'
    text = 'Bruiser.'
    flavor = 'Where an alux walks, a little dog trots behind.'
  }
  toh = Creature {
    name = 'Toh', epithet = 'the Cenote Bird'
    cost = 3, power = 5, health = 5
    number = 'AL1-D17', rarity = common
    art = 'art/AL1-D17.webp'
    text = 'Marksman. Clash start: Deal 2 damage to the enemy across.'
    flavor = 'Nests in the walls of the cenote and knows everything that goes on there.'
  }
  a-sweet-on-the-doorstep = Charm {
    name = 'A Sweet on the Doorstep'
    cost = 1
    number = 'AL1-D18', rarity = uncommon
    art = 'art/AL1-D18.webp'
    keywords = [@Ambush]
    text = 'Ambush. A unit you control gets +2 Power this round.'
    flavor = 'Sweets and fruit in the little house. The alux works twice as hard.'
  }
  lost-in-the-monte = Charm {
    name = 'Lost in the Monte'
    cost = 2
    number = 'AL1-D19', rarity = uncommon
    art = 'art/AL1-D19.webp'
    text = 'An enemy unit deals no damage in the first two bouts.'
    flavor = 'He walks you in circles until you say please.'
  }
]

@@@ aluxito-text
Exhaust: A unit you control gets +1 Rain-Fed.
Awaken: You have 7 or fewer Candles.
@@@ kahtal-alux-flavor
A doll-sized house at the edge of the field. Whoever lives in it guards the corn for seven years.
@@@
