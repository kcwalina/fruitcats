{
  "name": "@fruitcats/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "local": "tsx src/local.ts",
    "studio:dev": "tsx src/studio/dev.ts"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@fruitcats/engine": "*",
    "@fruitcats/store": "*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
