// spells: one-shot cards that resolve and leave play (Charms, instants, Trainers, actions).
// Depends on common for Cost.
#type Library

name = 'Spells'
version = '0.1'
requires = [@common]

type SpellCard : Card { cost: Cost? }
// A once-per-turn special card with its own single-capacity public zone (Weiss Schwarz, Chaos).
type ClimaxCard : SpellCard {}
type OneClimaxPerTurn : Rule { zone: Zone }

// Rules about spells, listed in the game's `spells` area. The first say which of the game's card
// types are spells (`SpellCards { types = [@Spell] }`); see core.alex on mapping.
type SpellRule : Rule {}
extension Game { spells: [SpellRule] = empty }
type SpellCards : SpellRule { types: [type SpellCard] }
type ClimaxCards : SpellRule { types: [type ClimaxCard] }

extension SpellCard { on-play: effect }           // required: every spell must do something

events = [
  play = Event { fields = [card = unit] }
]

// Ability kinds this library declares; a card constructs one to say it has the ability.
type OnPlay : Ability { holders = [nameof(SpellCard)], responding = [nameof(events.play)] }
