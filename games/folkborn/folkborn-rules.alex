// What cards in several families do. Each set's rules file attaches these to its cards, and they read the numbers of
// the card they're attached to (`card.boost`).
#type Rules

values = [
  boost-own-and-ready-an-offering = [
    Gain(Choose(own), power: card.boost, until: this-round)
    ReadyResources(one)
  ]
]
