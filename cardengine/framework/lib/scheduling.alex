// scheduling: when triggered effects resolve and in what order, and what a state check does.
// Depends on the core only.
scheduling = Library

name = 'Scheduling'
version = '0.1'
core = '1'

type SchedulingRule : Rule {}
extension Game { scheduling: [SchedulingRule] = empty }

type TriggersAfterStateCheck : SchedulingRule {}
type TriggersImmediately : SchedulingRule {}
type ActingPlayerFirst : SchedulingRule {}        // the acting player's triggers resolve first
type InitiativeFirst : SchedulingRule {}
type TriggersOpenNoWindow : SchedulingRule {}     // triggers cannot be responded to
type LossOnStateCheck : SchedulingRule {}         // loss conditions are checked between items
