// Folkborn, the game: a selection of libraries and of rules from them. § cites docs/rulebook.md
// section 13 (Comprehensive Rules). A rule not listed here does not apply.
#type Game

name = 'Folkborn'
rulebook = 'docs/rulebook.md'
schema-version = 1
uses = [
  @common
  @units
  @spells
  @attachments
  @heroes
  @abilities
  @life
  @life-stack
  @resources
  @turns
  @initiative
  @combat
  @responses
  @scheduling
  @objects
  @families
  @decks
  @setup
  @scenarios
]
sets = [
  @starter-box
  @berry-picnic
]

// The constants that shape the game, named once so rules and playtests share them.
constants = [
  // §11.1
  deck-size = 50
  max-copies = 3
  fabled-total = 6
  // §5
  candles = 9
  opening-hand = 6
  mulligan-up-to = 3
  // §5.5, §300
  setup-offerings = 2
  draw-per-round = 2
  max-hand = 10
  // §200.5
  yard-size = 6
  max-rounds = 40
]

// §3.2 Card types: our names for the libraries' card records. §200.2 A Hero is never a unit.
// §200.8 Fabled cards are unique. §200.6 one Talisman per unit.
type Hero : HeroCard {}
type Fabled : UnitCard { unique = true }
type Creature : UnitCard {}
type Charm : SpellCard {}
type Talisman : AttachmentCard { per-unit = 1 }

// §200.1 Zones, one of each per player. §100.5 what is hidden. §4 nobody may look at Candles.
zones = [
  Deck = Zone { shape = pile, role = deck, visible = none }
  Hand = Zone { shape = set, role = hand, visible = owner }
  Candles = Zone { shape = pile, role = life, visible = none }
  Offerings = Zone { shape = set, role = resource, visible = owner, face-down = true }
  Yard = Zone { shape = row, role = board, visible = all }
  Hearth = Zone { shape = slot, visible = all }
  Mist = Zone { shape = pile, role = discard, visible = all }
]

// §10 Keywords: each is a library's keyword type under our name. §700.3 Lucky plays are free.
keywords = [
  Swift = Swift {}
  Guardian = Guardian {}
  Sneaky = Sneaky {}
  Fierce = Fierce { value = 2 }
  Tough = Tough {}
  Lucky = Lucky {}
  Ambush = Ambush {}
  // Hiss! may only be played against an attack.
  AmbushOnAttack = Ambush { name = 'Ambush', only = @combat.events.attack }
]
event-names = [
  on-enter = 'Hello'
  on-defeated = 'Goodbye'
  awaken = 'Awaken'
  exhaust = 'Exhaust'
]
// §100.4 nothing else is random
randomness = [
  shuffle
  initiative
]
rules = [ZoneCapacity { zone = @Yard, n = @yard-size, cites = '§200.5' }]

// §11.1 Deckbuilding.
deck-rules = [
  DeckSize { n = @deck-size }
  CopiesMax { n = @max-copies }
  TypeCount { type = nameof(Hero), min = 1, max = 1 }
  CopyLimit { type = nameof(Fabled), copies = 1, total = @fabled-total }
]

// §5 Setup. Offering two cards is a resource policy below.
setup = [
  StartsInZone { type = nameof(Hero), zone = @Hearth, face = 1 }  // §5.1
  ShuffleDeck {}  // §5.2
  OpeningHand { n = @opening-hand }  // §5.3
  Mulligan { times = 1, up-to = @mulligan-up-to }  // §5.4
  RandomInitiative {}  // §5.6
]

// §700 Candles.
life = [
  LifeStack { name = nameof(Candles), zone = @Candles, size = @candles, from = @Deck }  // §5.2
  LostCardGoesTo { zone = @Hand, cites = '§700.1' }
  LoseOneAtATime { cites = '§700.1' }
  LoseWhenEmpty { cites = '§700.2' }
  EmptyDeckDrawCosts { n = 1, cites = '§700.4' }
]

// §200.3, §6.1 Offerings: any card face down is worth exactly 1.
resources = [
  Offerings = CardsAsResources {
    zone = @folkborn.zones.Offerings
    from = @Hand
    start = 0
    per-round = 1
    worth = 1
    pay-by = exhaust
  }
]
resource-rules = [
  NoIdentityWhileResource { resource = @folkborn.resources.Offerings, cites = '§200.3' }
  OfferAtSetup {
    resource = @folkborn.resources.Offerings
    count = @setup-offerings
    cites = '§5.5'
  }
  MayOfferAt {  // §6.1
    resource = @folkborn.resources.Offerings
    moment = @round-start
    count = 1
  }
]
cost-resource = @folkborn.resources.Offerings

// §300 Rounds.
turns = [
  AlternatingActions { first = initiative-holder, ends-when = all-pass-in-a-row, cites = '§300.3' }
  MaxRounds { n = @max-rounds }
  RoundStart {  // §300.2, skipped in round 1
    skip-round = 1
    steps = [
      ReadyAll {}
      ResetOncePerRound {}
      Triggers { of = @round-start }
      Draw { count = @draw-per-round }
    ]
  }
  Actions {  // §6.2
    allowed = [
      @common.actions.play
      @combat.actions.attack
      @abilities.actions.ability
      @take-initiative
      @pass
    ]
  }
  RoundEnd {  // §300.6
    steps = [
      Triggers { of = @round-end }
      ExpireThisRound {}
      DiscardTo { hand = @max-hand }
    ]
  }
]

// §300.4-6 The Lantern.
initiative = [
  InitiativeToken { name = 'Lantern' }
  TakeInitiativeAsAction {}
  AutoPassAfterTaking { cites = '§300.4' }
  TakeOncePerRound { cites = '§300.5' }
  InitiativePassesIfUntaken { cites = '§300.6d' }
]

// Units. §400.1d units enter exhausted; §800.1a damage >= Health defeats.
units = [
  UnitsEnterExhausted { cites = '§400.1d' }
  DefeatAtHealth { cites = '§800.1' }
]

// §600 Attacks.
combat = [
  AttackerChooses { targets = [unit, hero], cites = '§600.1' }
  AttackerMustBeReady {}
  // §600.1
  GuardiansFirst {}
  SneakyIgnoresGuardians {}
  // §600.3
  CancelledAttackerStaysExhausted {}
  NoRetarget {}
  // §600.4
  SimultaneousDamage {}
  DamagePersists { cites = '§600.6' }
  LifeDamage { n = 1, cites = '§600.5' }
]

// §500 Ambush.
responses = [
  ResponseWindows {  // §500.1
    name = nameof(Ambush)
    after = [
      @spells.events.play
      @combat.events.attack
    ]
  }
  // §500.2, §500.3
  OnePerWindow { n = 1 }
  NoNesting {}
  // §500.5, §500.6
  NotAnAction {}
  NoWindowForFreePlays {}
]

// §800 Triggers and state checks.
scheduling = [
  TriggersAfterStateCheck {}
  ActingPlayerFirst {}
  TriggersOpenNoWindow {}
  LossOnStateCheck {}
]

// §9.4, §800.5 Heroes. §8 an Awakened Hero may attack and takes no damage doing so.
hero = [
  TwoFaces {}
  AwakenOnStateCheck {}
  AwakenedKeepsExhaustedState {}
  AwakenedNeverReverts {}
  HeroAttacksWhenAwakened { takes-no-damage = true, cites = '§8' }
  PowerOncePerRound { cites = '§400.3' }
]

// §200.4, §200.7 Tokens and zone changes.
objects = [
  TokensVanishOffBoard { cites = '§200.4' }
  ZoneChangeResets { what = [damage, attachments, this-round], cites = '§200.7' }
]
