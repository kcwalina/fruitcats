#type Rules

for = @domowiki

// §850.2 Ready or exhausted Offerings both count.
routine is-well-fed : bool { own.resources.count >= @well-fed-at }

// §850.1 If the deck runs out, the rest does nothing; it never costs a Candle.
routine sprout { offer-from-deck(card.sprout, exhausted: true) }

@dziadzius.exhaust = ready-resources(one)
@dziadzius.awaken = own.resources.count >= card.offerings
@dziadzius.back.exhaust = ready-resources(two)

@stove-keeper.on-enter = ready-resources(one)
@moving-day-domowik.on-enter = sprout
@ovinnik-of-the-drying-barn.static = if not @is-well-fed { this.cant(attack) }
@bread-and-salt-greeter.on-enter = units(own).heal(card.heal)
@kikimora.on-enter = if @is-well-fed { draw(card.draw) }
@bowl-of-kasha.on-play = sprout
@a-domowiks-temper.on-play = choose(all).damage(card.damage)
@saucer-of-milk.on-play = boost-own-and-ready-an-offering
@old-bast-shoe.static = attached.grant(power: card.boost, health: card.extra-health)
@domowik-in-a-cats-shape.on-enter = sprout
@babunia.on-enter = ready-resources(one)
@klobuk.on-enter = draw()
@warm-hand-in-the-night.on-play = choose(own).buff(power: card.boost, until: this-round)
@knotted-mane.on-play = choose(opponents).exhaust()
