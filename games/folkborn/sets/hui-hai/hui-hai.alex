#type FamilySet

id = 'hui-hai'
name = 'Hui Hai'
code = 'HH1'

family = Family {
  name = 'Hui Hai'
  main = '#4E9A3A'
  dark = '#24501A'
  tint = '#E9F5E1'
}

keywords = [
  stone-for-stone = Keyword { name = 'Stone for Stone' }
]

cards = [
  pebble = Hero {
    name = 'Pebble', epithet = 'the Littlest Hui Hai'
    number = 'HH1-H01', rarity = legendary
    frame = gold
    art = 'art/HH1-H01-kitten.webp'
    text = @pebble-text
    constants = [
      boost = 1
      fallen = 22
    ]
    flavor = 'Nobody has ever seen her. Plenty of people have met her pebbles.'
    back = Awakened {
      name = 'Pebble', epithet = 'Keeper of the Stream', power = 3
      art = 'art/HH1-H01-bigcat.webp'
      text = @pebble-back-text
      constants = [
        extra-power = 1
        damage = 2
      ]
    }
  }
  hui-hai-of-the-stream = Creature {
    name = 'Hui Hai of the Stream'
    cost = 2, power = 3, health = 5
    number = 'HH1-D01', rarity = common
    art = 'art/HH1-D01.webp'
    text = 'Bruiser.'
    flavor = 'A ripple where there is no fish. A splash where there is no stone.'
  }
  ya-hui-hai = Fabled {
    name = 'Yă Hui Hai', epithet = 'Lady of the Ferns'
    cost = 4, power = 1, health = 11
    number = 'HH1-D02', rarity = rare
    art = 'art/HH1-D02.webp'
    text = 'Support. Each bout: The units next to Yă Hui Hai heal 2.'
    flavor = 'Small enough to sleep in a fern. Strong enough to move the rock beside it.'
  }
  a-pebble-at-your-feet = Charm {
    name = 'A Pebble at Your Feet'
    cost = 1
    number = 'HH1-D03', rarity = uncommon
    art = 'art/HH1-D03.webp'
    keywords = [@Ambush]
    text = 'Ambush. Deal 2 damage to an enemy unit.'
    flavor = 'Behave badly in the forest, and a stone lands beside you. Nobody threw it.'
  }
  hui-hai-in-the-ferns = Creature {
    name = 'Hui Hai in the Ferns'
    cost = 2, power = 2, health = 6
    number = 'HH1-D04', rarity = common
    art = 'art/HH1-D04.webp'
    keywords = [@Taunt]
    text = 'Tank. Taunt.'
    flavor = 'The fern moved. There was no wind.'
  }
  pebble-thrower = Creature {
    name = 'Pebble-Thrower'
    cost = 1, power = 3, health = 2
    number = 'HH1-D05', rarity = common
    art = 'art/HH1-D05.webp'
    text = 'Assassin.'
    flavor = 'No taller than your thumb. Throws harder than you do.'
  }
  hui-hai-at-the-spring = Creature {
    name = 'Hui Hai at the Spring'
    cost = 1, power = 1, health = 5
    number = 'HH1-D06', rarity = common
    art = 'art/HH1-D06.webp'
    text = 'Tank. Once per round, after Hui Hai at the Spring survives damage, deal 1 damage to an enemy unit.'
    flavor = 'Muddy the spring, and see what comes back out of it.'
  }
  boulder-pusher = Creature {
    name = 'Boulder-Pusher'
    cost = 3, power = 6, health = 6
    number = 'HH1-D07', rarity = common
    art = 'art/HH1-D07.webp'
    text = 'Bruiser.'
    flavor = 'The boulder was on the path in the evening. In the morning it wasn''t.'
  }
  hui-hai-in-the-bamboo = Creature {
    name = 'Hui Hai in the Bamboo'
    cost = 1, power = 2, health = 3
    number = 'HH1-D08', rarity = common
    art = 'art/HH1-D08.webp'
    keywords = [@Swift]
    text = 'Bruiser. Swift.'
    flavor = 'You hear the bamboo knock. You never see who knocked.'
  }
  keeper-of-the-old-forest = Creature {
    name = 'Keeper of the Old Forest'
    cost = 3, power = 3, health = 8
    number = 'HH1-D09', rarity = common
    art = 'art/HH1-D09.webp'
    keywords = [@Taunt]
    text = 'Tank. Taunt. Once per round, after Keeper of the Old Forest survives damage, deal 1 damage to an enemy unit.'
    flavor = 'The forest is theirs to keep, and they keep it well.'
  }
  gohlou = Creature {
    name = 'Gơhlŏu', epithet = 'the Sweet-Smelling'
    cost = 3, power = 2, health = 6
    number = 'HH1-D10', rarity = uncommon
    art = 'art/HH1-D10.webp'
    text = 'Mage. Every second bout: Deal 2 damage to the enemy across.'
    flavor = 'Something lives in the trees. Nobody has seen it, but it smells wonderful.'
  }
  moss-mender-ya-hui-hai = Creature {
    name = 'Moss-Mender Yă Hui Hai'
    cost = 2, power = 0, health = 6
    number = 'HH1-D11', rarity = uncommon
    art = 'art/HH1-D11.webp'
    text = 'Support. Clash start: The units next to Moss-Mender Yă Hui Hai get +2 Health this round.'
    flavor = 'She tucks moss into every scrape, grumbling the whole time.'
  }
  old-one-of-the-waterfall = Creature {
    name = 'Old One of the Waterfall'
    cost = 4, power = 4, health = 12
    number = 'HH1-D12', rarity = uncommon
    art = 'art/HH1-D12.webp'
    keywords = [@Fierce]
    text = 'Tank. Fierce. Once per round, after Old One of the Waterfall survives damage, deal 2 damage to an enemy unit.'
    flavor = 'The waterfall has been loud for a thousand years. Some of that is him.'
  }
  stones-from-nowhere = Charm {
    name = 'Stones from Nowhere'
    cost = 2
    number = 'HH1-D13', rarity = uncommon
    art = 'art/HH1-D13.webp'
    text = 'Deal 1 damage to each enemy unit.'
    flavor = 'A whole hillside of pebbles, and not one hand to be seen.'
  }
  the-forest-remembers = Charm {
    name = 'The Forest Remembers'
    cost = 3
    number = 'HH1-D14', rarity = uncommon
    art = 'art/HH1-D14.webp'
    text = 'Deal 4 damage to an enemy unit.'
    flavor = 'Cut a tree for nothing, and the forest will not forget your face.'
  }
  nobody-threw-it = Charm {
    name = 'Nobody Threw It'
    cost = 2
    number = 'HH1-D15', rarity = uncommon
    art = 'art/HH1-D15.webp'
    text = 'An enemy unit deals no damage in the first two bouts.'
    flavor = 'The hunter turned around. The path behind him was empty.'
  }
  a-pouch-of-river-pebbles = Talisman {
    name = 'A Pouch of River Pebbles'
    cost = 2
    number = 'HH1-D16', rarity = uncommon
    art = 'art/HH1-D16.webp'
    text = 'Attached unit gets +1 Power and Stone for Stone.'
    flavor = 'Smooth, round, and exactly the right size for throwing.'
  }
  grandfather-hui-hai = Fabled {
    name = 'Grandfather Hui Hai', epithet = 'Mover of Rocks'
    cost = 5, power = 8, health = 12
    number = 'HH1-D17', rarity = rare
    art = 'art/HH1-D17.webp'
    keywords = [@Fierce]
    text = 'Bruiser. Fierce. Clash start: Deal 4 damage to the enemy across.'
    flavor = 'The strongest of them, and the smallest beard in the forest.'
  }
  the-hidden-village = Creature {
    name = 'The Hidden Village'
    cost = 4, power = 3, health = 9
    number = 'HH1-D18', rarity = rare
    art = 'art/HH1-D18.webp'
    text = 'Mage. Every second bout: Deal 2 damage to the enemy across and the ones next to it.'
    flavor = 'A whole village lives in this clearing. You are standing in it.'
  }
  the-rock-that-moved-in-the-night = Fabled {
    name = 'The Rock That Moved in the Night'
    cost = 5, power = 9, health = 10
    number = 'HH1-D19', rarity = rare
    art = 'art/HH1-D19.webp'
    keywords = [@Fierce]
    text = 'Bruiser. Fierce.'
    flavor = 'Everyone saw it on the hill. Nobody saw how it got there.'
  }
  small-but-strong = Charm {
    name = 'Small but Strong'
    cost = 1
    number = 'HH1-D20', rarity = uncommon
    art = 'art/HH1-D20.webp'
    keywords = [@Ambush]
    text = 'Ambush. A unit you control gets +2 Power this round.'
    flavor = 'Tiny hands. Enormous shove.'
  }
]

@@@ pebble-text
Exhaust: A unit you control gets +{boost} Power this round.
Awaken: {fallen} or more units have gone down in Clashes this game.
@@@ pebble-back-text
Your units get +{extra-power} Power.
Exhaust: Deal {damage} damage to an enemy unit.
@@@
