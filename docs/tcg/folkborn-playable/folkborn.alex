// Folkborn, playable. Today's games/folkborn/folkborn.alex (what the cards print) plus the rules that let the
// engine play it. Each rule cites the rulebook, docs/rulebook.md, part 13. A rule that isn't listed doesn't apply.
#type Game

name = 'Folkborn'
schema-version = 1
rulebook = '../../docs/rulebook.md'
card-layout = @card-layout
sets = [
  @domowiki
  @pari
  @aluxes
  @jiaoren
  @hui-hai
  @mochi
]
uses = [
  @common
  @units
  @spells
  @attachments
  @heroes
  @abilities
  @life
  @life-stack
  @resources
  @turns
  @initiative
  @combat
  @responses
  @scheduling
  @objects
  @families
  @decks
  @setup
]

// §900 The numbers that shape the game, named once so the rules, the rulebook and playtests share them.
constants = [
  // §11.1
  deck-size = 50
  max-copies = 3
  fabled-copies = 1
  fabled-total = 6
  families-per-deck = 2
  // §5
  candles = 9
  opening-hand = 6
  mulligan-up-to = 3
  setup-offerings = 2
  // §300
  draw-per-round = 2
  offerings-per-round = 1
  max-hand = 10
  // §200.5
  yard-size = 6
  // §600.5
  candles-per-hit = 1
  candles-per-fierce-hit = 2
  // §850
  well-fed-at = 7
  company-at = 3
  rain-fed-max = 2
  // §300.7
  max-rounds = 40
]

keywords = [
  Swift = Keyword {}
  Guardian = Keyword {}
  Sneaky = Keyword {}
  Fierce = Keyword {}
  Tough = Keyword {}
  Lucky = Keyword {}
  Ambush = Keyword {}
]

enum Rarity { common, uncommon, rare, legendary }
enum Finish { standard, foil, gold, prismatic, signature }
enum Palette { citrus, orchard, tropical, garden, berry, melon, pepper, violet, sky, midnight, gold, ink, image }

type Family {
  name: text
  main: text
  dark: text
  tint: text
}

// A Folkborn set is one family's cards: the family's name and colours are printed on every card in it.
type FamilySet : Set { family: Family }

// §3.2 The card types, as printed. The rules below map them onto the libraries' card records.
type Printed : Card {
  number: text
  rarity: Rarity?
  epithet: text?
  family: Family?
  frame: Palette?
  frame-image: text?
  finishes: [Finish] = [standard, foil, gold, prismatic]
}
type Creature : Printed {
  cost: int
  power: int
  health: int
}
type Fabled : Printed {
  cost: int
  power: int
  health: int
}
type Charm : Printed {
  cost: int
}
type Talisman : Printed {
  cost: int
}
type Hero : Printed {
  back: Awakened
}
type Awakened : Card {
  type-name = 'Hero · Awakened'
  epithet: text?
  power: int?
}
type TokenCreature : Creature {
  type-name = 'Token Creature'
  finishes = [standard]
}

// §200.1 One of each per player. §100.5 What is hidden. §4 Nobody may look at the Candles.
zones = [
  Deck = Zone { shape = pile, role = deck, visible = none }
  Hand = Zone { shape = set, role = hand, visible = owner }
  Candles = Zone { shape = pile, role = life, visible = none }
  Offerings = Zone { shape = set, role = resource, visible = owner, face-down = true }
  Yard = Zone { shape = row, role = board, visible = all }
  Hearth = Zone { shape = slot, visible = all }
  Mist = Zone { shape = pile, role = discard, visible = all }
]

// §100.4 Shuffling and the first Lantern holder are the only randomness.
randomness = [
  shuffle
  initiative
]

rules = [
  ZoneCapacity { zone = @Yard, n = @yard-size, cites = '§200.5' }
  FamilyLimit { n = @families-per-deck, cites = '§11.1' }
]

// §11.1 Deckbuilding.
deck-rules = [
  DeckSize { n = @deck-size }
  CopiesMax { n = @max-copies }
  TypeCount { type = nameof(Hero), min = 1, max = 1 }
  CopyLimit { type = nameof(Fabled), copies = @fabled-copies, total = @fabled-total }
]

// §5 Setup. Offering two cards is a resource rule, below.
setup = [
  StartsInZone { type = nameof(Hero), zone = @Hearth, cites = '§5.1' }
  ShuffleDeck { cites = '§5.2' }
  OpeningHand { n = @opening-hand, cites = '§5.3' }
  Mulligan { times = 1, up-to = @mulligan-up-to, cites = '§5.4' }
  RandomInitiative { cites = '§5.6' }
]

// §700 Candles.
life = [
  LifeStack { name = 'Candles', zone = @Candles, size = @candles, from = @Deck, cites = '§5.2' }
  LostCardGoesTo { zone = @Hand, cites = '§700.1' }
  LoseOneAtATime { cites = '§700.1' }
  LoseWhenEmpty { cites = '§700.2' }
  PlayFreeWhenLost { keyword = @Lucky, cites = '§700.3' }
  EmptyDeckDrawCosts { n = 1, cites = '§700.4' }
]

// §200.3 Offerings: any card, face down, is worth exactly 1.
resources = [
  Offerings = CardsAsResources {
    zone = @folkborn.zones.Offerings
    from = @Hand
    start = 0
    per-round = @offerings-per-round
    worth = 1
    pay-by = exhaust
  }
]
resource-rules = [
  NoIdentityWhileResource { resource = @folkborn.resources.Offerings, cites = '§200.3' }
  OfferAtSetup { resource = @folkborn.resources.Offerings, count = @setup-offerings, cites = '§5.5' }
  MayOfferAt {
    resource = @folkborn.resources.Offerings
    moment = @round-start
    count = @offerings-per-round
    cites = '§300.2d'
  }
]
cost-resource = @folkborn.resources.Offerings

// §300 Rounds.
turns = [
  AlternatingActions { first = initiative-holder, ends-when = all-pass-in-a-row, cites = '§300.3' }
  MaxRounds {
    n = @max-rounds
    winner = [
      most-life
      most-unit-health
    ]
    cites = '§300.7'
  }
  RoundStart {
    skip-round = 1
    steps = [
      ReadyAll {}
      ResetOncePerRound {}
      Triggers { of = @round-start }
      Draw { count = @draw-per-round }
    ]
    cites = '§300.2'
  }
  Actions {
    allowed = [
      @common.actions.play
      @combat.actions.attack
      @abilities.actions.ability
      @take-initiative
      @pass
    ]
    cites = '§6.2'
  }
  RoundEnd {
    steps = [
      Triggers { of = @round-end }
      ExpireThisRound {}
      DiscardTo { hand = @max-hand }
    ]
    cites = '§300.6'
  }
]

// §300.4-6 The Lantern.
initiative = [
  InitiativeToken { name = 'Lantern' }
  TakeInitiativeAsAction {}
  AutoPassAfterTaking { cites = '§300.4' }
  TakeOncePerRound { cites = '§300.5' }
  InitiativePassesIfUntaken { cites = '§300.6d' }
]

// §200.2 Fabled cards, Creatures and tokens are units; a Hero never is.
units = [
  UnitCards {
    types = [
      @Creature
      @Fabled
    ]
  }
  UnitsEnterExhausted { cites = '§400.1d' }
  EntersReady { keyword = @Swift, cites = '§10' }
  DamageReduction { keyword = @Tough, cites = '§600.6' }
  DefeatAtHealth { cites = '§800.1a' }
]

// §3.2 Charms do what they say, then go to the Mist.
spells = [
  SpellCards { types = [@Charm] }
]

// §200.6 One Talisman per unit; it goes to the Mist when its unit leaves.
attachments = [
  AttachmentCards { types = [@Talisman] }
]

// §9.4, §800.5 Heroes. §8 An Awakened Hero may attack, and takes no damage doing so.
hero = [
  HeroCards { types = [@Hero], second-face = back }
  TwoFaces {}
  AwakenOnStateCheck { cites = '§800.1b' }
  AwakenedKeepsExhaustedState { cites = '§800.5' }
  AwakenedNeverReverts { cites = '§9.4' }
  HeroAttacksWhenAwakened { takes-no-damage = true, cites = '§600.4' }
  PowerOncePerRound { cites = '§400.3' }
]

// §600 Attacks.
combat = [
  AttackerChooses {
    targets = [
      unit
      hero
    ]
    cites = '§600.1'
  }
  AttackerMustBeReady { cites = '§600.1' }
  GuardiansFirst { keyword = @Guardian, cites = '§600.1' }
  SneakyIgnoresGuardians { keyword = @Sneaky, cites = '§600.1' }
  CancelledAttackerStaysExhausted { cites = '§600.3' }
  NoRetarget { cites = '§600.3' }
  SimultaneousDamage { cites = '§600.4' }
  DamagePersists { cites = '§600.6' }
  LifeDamage { n = @candles-per-hit, cites = '§600.5' }
  HitCostsLife { keyword = @Fierce, n = @candles-per-fierce-hit, cites = '§600.5' }
]

// §500 Ambush.
responses = [
  ResponseWindows {
    name = 'Ambush'
    after = [
      @spells.events.play
      @combat.events.attack
    ]
    cites = '§500.1'
  }
  PlayableInResponse { keyword = @Ambush, cites = '§500.2' }
  OnePerWindow { n = 1, cites = '§500.2' }
  NoNesting { cites = '§500.3' }
  NotAnAction { cites = '§500.5' }
  NoWindowForFreePlays { cites = '§500.6' }
]

// §800 Triggers and state checks.
scheduling = [
  TriggersAfterStateCheck { cites = '§800.2' }
  ActingPlayerFirst { cites = '§800.3' }
  TriggersOpenNoWindow { cites = '§800.2' }
  LossOnStateCheck { cites = '§800.1c' }
]

// §200.4 Tokens. §200.7 A unit that changes zones is a new object. §850.5 Rain counters go too.
objects = [
  TokensVanishOffBoard { cites = '§200.4' }
  ZoneChangeResets {
    what = [
      damage
      attachments
      this-round
      counters
    ]
    cites = '§200.7'
  }
]

// The Artist Studio's brief for a set: the pictures an artist is asked for, in steps. Everything in it is a
// suggestion to the artist except a picture's file, size and kind.
type ArtBrief {
  set: Set
  about: text?
  audience: text?
  style: text?
  note: text?
  families: [text: FamilyBrief] = empty
  steps: [text: ArtStep]
}
type FamilyBrief {
  world: text
  note: text?
}
type ArtStep {
  title: text
  note: text?
  pictures: [text: ArtPicture]
}
enum PictureKind { card, token, portrait, announcement }
enum ArtTier { deck, token, foil, gold, signature, legend, announcement }
enum PaintStyle { painted, sticker }
enum HeroFace { front, back }
enum SignatureWish { requested, welcome }
enum Suggestable { name, flavor, look, scene, object, characters, rules, other }
type ArtPicture {
  file: text
  kind: PictureKind = card
  size: [int, int]
  card: Card?
  face: HeroFace?
  tier: ArtTier
  style: PaintStyle?
  draw: text
  must-keep: [text] = empty
  open: [Suggestable] = empty
  showcase: bool = false
  main: bool = false
  signature: SignatureWish?
  portrait: ArtPicture?
  family: text?
  working-name: text?
  frame-choice: bool = false
  frame-palette: text?
}
