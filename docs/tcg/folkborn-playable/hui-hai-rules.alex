#type Rules

for = @hui-hai

// §850.7 Its owner picks the enemy unit.
@stone-for-stone.on-survives-damage = choose(opponents).damage(one)

@pebble.exhaust = choose(own).buff(power: card.boost, until: this-round)
@pebble.awaken = mist-is-full
@pebble.back.static = units(own).grant(health: card.extra-health, stone-for-stone)
@pebble.back.exhaust = choose(opponents).damage(card.damage)

@hui-hai-of-the-stream.on-enter = choose(opponents).damage(card.damage)
@ya-hui-hai.on-enter = choose(opponents).damage(card.damage)
@a-pebble-at-your-feet.on-play = choose(opponents).damage(card.damage)
@gohlou.on-enter = draw()
@moss-mender-ya-hui-hai.on-enter = units(own).heal(card.heal)
@stones-from-nowhere.on-play = units(opponents).damage(card.damage)
@the-forest-remembers.on-play = choose(all).damage(card.damage)
@nobody-threw-it.on-play = choose(opponents).exhaust()
@a-pouch-of-river-pebbles.static = attached.grant(power: card.boost, stone-for-stone)
@grandfather-hui-hai.on-enter = choose(opponents).damage(card.damage)
@the-hidden-village.on-enter = units(opponents).damage(card.damage)
@small-but-strong.on-play = choose(own).buff(power: card.boost, until: this-round)
