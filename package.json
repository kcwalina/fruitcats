{
  "name": "fruitcats",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fruitcats/web",
    "build": "npm run build -w @fruitcats/web",
    "preview": "npm run preview -w @fruitcats/web",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "tsx packages/engine/scripts/simulate.ts",
    "demo:record": "tsx tools/demo/record.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
