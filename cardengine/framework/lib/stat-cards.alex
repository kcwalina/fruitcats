// stat-cards: cards that are only a set of comparable numbers, played from a fixed line-up and
// compared head to head (Match Attax, Adrenalyn XL, Cricket Attax). No cost, no persistence, no
// combat. Depends on the core only.
#type Library

name = 'Stat cards'
version = '0.1'

type StatCard : Card { stats: [text: int] }

type StatDuelRule : Rule {}
extension Game { stat-duel: [StatDuelRule] = empty }

// Which of the game's card types are stat cards; see core.alex on mapping.
type StatCards : StatDuelRule { types: [type StatCard] }
type Lineup : StatDuelRule { slots: int }                // each player fields n cards
type ChooseStat : StatDuelRule {}                        // the attacker names the stat compared
type HigherWins : StatDuelRule { ties: text }            // 'attacker', 'defender' or 'none'
type ComboBonus : StatDuelRule { bonus: int }            // paired cards add to the total
type BestOf : StatDuelRule { duels: int }                // the match is a series

actions = [
  duel = ActionKind { name = 'Duel' }
]

events = [
  duel = Event { fields = [attacker = unit, defender = unit, stat = text] }
]

verbs = [
  duel = Verb { on = unit, params = [target = unit, stat = text] }
]
