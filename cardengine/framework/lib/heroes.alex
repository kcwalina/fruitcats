// heroes: a card that is always in play and represents the player (Hero, leader, avatar,
// planeswalker), with one or two faces, optional stats of its own, and a repeatable ability.
// Depends on the core only.
heroes = Library

name = 'Heroes'
version = '0.1'
core = '1'

type HeroCard : Card {
  face1: Face
  face2: Face?
  life: int?                      // when the hero card fixes the player's life total
  hand-size: int?                 // when the hero card fixes the hand size (intellect)
}
type Face {
  name: text
  power: int?
  keywords: [Keyword | Applied] = empty
  abilities: [Ability] = empty
}

type HeroRule : Rule {}
extension Game { hero: [HeroRule] = empty }

type TwoFaces : HeroRule {}                           // face 2 is reached by awakening
type AwakenOnStateCheck : HeroRule {}                 // flip as soon as the condition holds
type AwakenedKeepsExhaustedState : HeroRule {}
type AwakenedNeverReverts : HeroRule {}
type HeroAttacksWhenAwakened : HeroRule { takes-no-damage: bool }
type PowerOncePerRound : HeroRule {}                  // the face's `exhaust` ability, once a round

extension Face {
  exhaust: effect?
  awaken: condition?
}

// Ability kinds this library declares; a card constructs one to say it has the ability.
type Exhaust : Ability { holders = [nameof(Face)] }
type Awaken : Ability { holders = [nameof(Face)], kind = condition }
