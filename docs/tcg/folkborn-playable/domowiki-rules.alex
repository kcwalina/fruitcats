#type Rules

for = @domowiki

// §850.2 Ready or exhausted Offerings both count.
condition is-well-fed { own.resources.count >= @well-fed-at }

// §850.1 If the deck runs out, the rest does nothing; it never costs a Candle.
effect sprout { offer-from-deck(card.sprout, exhausted: true) }

effect well-fed-draw { if @is-well-fed { draw(card.draw) } }
static hungry { if not @is-well-fed { this.cant(attack) } }
condition enough-offerings { own.resources.count >= card.offerings }

@dziadzius.exhaust = ready-an-offering
@dziadzius.awaken = enough-offerings
@dziadzius.back.exhaust = ready-two-offerings

@stove-keeper.on-enter = ready-an-offering
@moving-day-domowik.on-enter = sprout
@ovinnik-of-the-drying-barn.static = hungry
@bread-and-salt-greeter.on-enter = heal-each-own
@kikimora.on-enter = well-fed-draw
@bowl-of-kasha.on-play = sprout
@a-domowiks-temper.on-play = damage-a-unit
@saucer-of-milk.on-play = boost-own-and-ready-an-offering
@old-bast-shoe.static = attached-power-and-health
@domowik-in-a-cats-shape.on-enter = sprout
@babunia.on-enter = ready-an-offering
@klobuk.on-enter = draw-a-card
@warm-hand-in-the-night.on-play = boost-own
@knotted-mane.on-play = exhaust-an-enemy

static attached-power-and-health { attached.grant(power: card.boost, health: card.extra-health) }
