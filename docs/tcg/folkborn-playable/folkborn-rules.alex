// What cards in several families do. Each set's rules file attaches these to its cards, and a handler reads the
// numbers of the card it's attached to (`card.damage`).
#type Rules

for = @folkborn

routine boost-own-and-ready-an-offering {
  choose(own).buff(power: card.boost, until: this-round)
  ready-resources(one)
}

// Zhu'er and Pebble awaken on it. Both players' Mists count, as today's engine counts them.
routine mist-is-full : bool { cards(@Mist, all, unit-card).count >= card.fallen }
