// board: units that stand on a grid and move, with range, line of sight and terrain. Twelve of
// the 156 surveyed games. Uses the core's grid zones, `coords`, `facing`, `turn`, `create-zone`
// and the `adjacent` query. Depends on units.
#type Library

name = 'Board'
version = '0.1'
requires = [@units]

type BoardRule : Rule {}
extension Game { board: [BoardRule] = empty }

type Movement : BoardRule { range: int }                // a unit may move up to n cells
type MovementCost : BoardRule { resource: text, per-cell: int }
type AttackRange : BoardRule { range: int }             // attacks reach n cells; 1 is adjacent
type LineOfSight : BoardRule {}                         // blocked cells stop attacks and abilities
type Facing : BoardRule { directions: int }             // 4 or 8; attacks and patterns use it
type AdjacencyTriggersBattle : BoardRule {}             // moving next to an enemy starts combat
type TerrainModifier : BoardRule { cell-property: text }   // a cell changes what stands on it
type BuildBoard : BoardRule { from: CardType | text }          // players lay the cells during play

extension UnitCard {
  move: int?                      // this unit's own movement, overriding Movement
  reach: int?                     // this unit's own attack range
}
extension Zone {
  terrain: [text: text] = empty   // per-cell properties, keyed by 'column,row'
}

actions = [
  move = ActionKind { name = 'Move' }
]

moments = [
  moved = Moment { name = 'A unit moved' }
]

extension UnitCard { on-move: effect? }
type OnMove : Ability { holders = [nameof(UnitCard)] }

selectors = [
  within = Selector { yields = units, params = [of = unit, range = int] }
  in-line = Selector { yields = units, params = [of = unit, direction = int] }
  cell = Selector { yields = units, params = [at = coords] }
]

properties = [
  distance = Property { on = unit, yields = int }       // to a second unit, given as argument
]

verbs = [
  move-to = Verb { on = unit, params = [at = coords] }
  turn-to = Verb { on = unit, params = [facing = int] }
  push = Verb { on = unit, params = [cells = int] }     // away from the acting unit
  place-cell = Verb { on = player, params = [card = card, at = coords] }   // BuildBoard
]
