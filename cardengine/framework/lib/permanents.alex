// permanents: cards that stay in play, fight nothing and attach to nothing (Items, Locations,
// Tamers, Artifacts, Stadiums, Secrets). Depends on common for Cost.
#type Library

name = 'Permanents'
version = '0.1'
requires = [@common]

type PermanentCard : Card {
  cost: Cost?
  health: int?                    // a base or location with hit points
  shared: bool = false            // one in play for both players, replaced when another is played
  capacity: int?                  // how many units may be at it
}

// Rules about permanents, listed in the game's `permanents` area. `PermanentCards` says which of
// the game's card types are permanents; see core.alex on mapping.
type PermanentRule : Rule {}
extension Game { permanents: [PermanentRule] = empty }
type PermanentCards : PermanentRule { types: [type PermanentCard] }

extension PermanentCard {
  on-enter: Effects?
  on-leave: Effects?
  static: Effects?
}

// Ability kinds this library declares; a card constructs one to say it has the ability.
type OnPermanentEnter : Ability { holders = [nameof(PermanentCard)] }
type OnLeave : Ability { holders = [nameof(PermanentCard)] }
type PermanentStatic : Ability { holders = [nameof(PermanentCard)], kind = static }
// Fires on its event without a window and reveals itself (secrets, traps).
type OnEvent : Ability { holders = [nameof(PermanentCard)], hidden = true }
