// life: how a player loses. The base every life rule shares, life as a number, shields, and
// losing on a failed draw. Life as a stack of cards is the life-stack library, built on this.
// Depends on the core only.
#type Library

name = 'Life'
version = '0.1'

type LifeRule : Rule {}
extension Game { life: [LifeRule] = empty }

// Life as a number (20 life, 8000 LP, 30 hero health).
type LifeCounter : LifeRule {
  name: text
  start: int
  lose-at: int
}
type LifeShield : LifeRule { name: text }         // a counter that absorbs damage first (armor)
type LoseOnEmptyDraw : LifeRule {}                // drawing from an empty deck loses outright
// Drawing from an empty deck costs life; `growth` makes each successive one cost more.
type EmptyDeckDrawCosts : LifeRule { n: int, growth: int = 0 }
type WinAtCounter : LifeRule { counter: text, n: int }   // first to n of a counter wins (lore)
// Life as separate objects each with hit points (provinces, towers, zones with defence).
type LifeObjects : LifeRule { type: CardType | text, lose-when: int }
type DamageTiers : LifeRule { tiers: [text] }            // damage moves a unit through named states
type RuneThresholds : LifeRule { every: int }            // losing n life triggers (a draw, a play)

properties = [
  life = Property { on = player, yields = units }        // .count on a stack, the total on a number
]

verbs = [
  damage-life = Verb { on = player, params = [amount = int] }
]
